<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
    <AssemblyName>Witcher3FontTool</AssemblyName>
    <RootNamespace>Witcher3FontTool</RootNamespace>
    <Product>Witcher 3 Font Tool</Product>
    <Description>Unofficial font replacement mod generator for The Witcher 3 (next-gen).</Description>
    <Authors>jakeouyang</Authors>
    <RepositoryUrl>https://github.com/jakeouyang/Witcher3FontTool</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release builds default to a self-contained single-file exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/*" />
  </ItemGroup>

</Project>
